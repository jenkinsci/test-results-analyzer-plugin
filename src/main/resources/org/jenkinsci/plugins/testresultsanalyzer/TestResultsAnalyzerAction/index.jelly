<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout">
  <l:layout title="${it.displayName}">
    <st:include it="${it.project}" page="sidepanel.jelly" />
    <l:main-panel>
      <st:adjunct includes="io.jenkins.plugins.echarts" />

      <l:app-bar title="${%Test Results Analyzer}">
        <button type="button" id="tra-options-toggle" class="jenkins-button" aria-expanded="false">
          <l:icon src="symbol-options-outline plugin-ionicons-api" />
          ${%Options}
        </button>
        <button type="button" id="tra-download-csv" class="jenkins-button">
          <l:icon src="symbol-download-outline plugin-ionicons-api" />
          ${%Download CSV}
        </button>
      </l:app-bar>

      <!-- Rendered by src/main/frontend/analyzer -->
      <div id="tra-root"
           data-action-url="${rootURL}/${it.project.url}${it.urlName}/"
           data-bootstrap="${it.bootstrapJson}" />
      <script type="module" src="${resURL}/plugin/test-results-analyzer/js/bundles/analyzer-bundle.js" />
    </l:main-panel>
  </l:layout>
</j:jelly>
